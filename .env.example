# GNews API key — https://gnews.io/ (free tier: 100 requests/day)
#
# Note the missing NEXT_PUBLIC_ prefix: this value is read only inside the
# server route handler (app/api/news/route.ts) and never reaches the browser
# bundle. That is the whole point of the proxy — see README, "Why a proxy".
#
# Leave it unset and the app runs in demo mode against local fixtures, which is
# also how CI and the e2e suite run.
GNEWS_API_KEY=

# Optional: cache TTL in seconds for upstream responses (default 300)
# NEWS_CACHE_TTL=300

# Optional: public base URL, used for canonical and Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
